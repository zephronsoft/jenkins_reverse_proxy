# Jenkins Nginx Reverse Proxy Environment Configuration
# Copy this file to .env and customize the values

# Domain name for your Jenkins instance
# Replace with your actual domain name
DOMAIN=jenkins.funsports.bet

# Email address for Let's Encrypt SSL certificates
EMAIL=chenny@admin.com

# Jenkins server connection details
JENKINS_HOST= 10.8.112.16
JENKINS_PORT=8080

# SSL configuration
# Set to "false" to disable SSL and use HTTP only
SSL_ENABLED=true

# Optional: If you want to run Jenkins in Docker as well
# Uncomment the following lines and adjust as needed
# JENKINS_USER=1000
# JENKINS_GROUP=1000 